---
const today = new Date();
---

<footer class="border-t border-white/10 bg-[#060816]">
	<div class="mx-auto flex max-w-4xl flex-col gap-4 px-6 py-8 text-sm text-slate-400 sm:flex-row sm:items-center sm:justify-between sm:px-8">
		<p>&copy; {today.getFullYear()} Fran Fuerte. Todos los derechos reservados.</p>
		<div class="flex flex-wrap items-center gap-5">
			<a href="/" class="transition hover:text-white">Inicio</a>
			<a href="/blog/" class="transition hover:text-white">Blog</a>
			<a href="/about/" class="transition hover:text-white">Sobre mí</a>
			<a href="https://www.linkedin.com/in/franfuertegrund/" target="_blank" rel="noreferrer" class="transition hover:text-white">LinkedIn</a>
			<a href="/contacto/" class="transition hover:text-white">Contacto</a>
		</div>
	</div>

	<!-- Málaga — La Manquita, la playa y el espeto. Para los que saben. -->
	<div class="mx-auto flex max-w-4xl flex-col items-center gap-2 border-t border-white/[0.04] px-6 pb-5 pt-4">
		<svg
			width="240"
			height="62"
			viewBox="0 0 240 62"
			fill="none"
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
			opacity="0.28"
		>
			<!-- Línea de horizonte / mar -->
			<line x1="0" y1="50" x2="240" y2="50" stroke="#94a3b8" stroke-width="0.7"/>

			<!-- Olas (izquierda) -->
			<path d="M4 49.5 Q11 45.5 18 49.5 Q25 53.5 32 49.5 Q39 45.5 46 49.5 Q53 53.5 60 49.5"
				stroke="#94a3b8" stroke-width="0.9" stroke-linecap="round"/>

			<!-- LA MANQUITA — Catedral de Málaga -->
			<!-- Nave principal -->
			<rect x="68" y="40" width="76" height="10" fill="#94a3b8" rx="0.5"/>
			<!-- Torre izquierda (completa — alta, con chapitel) -->
			<rect x="70" y="11" width="19" height="29" fill="#94a3b8"/>
			<polygon points="79.5,1 70,11 89,11" fill="#94a3b8"/>
			<!-- Cruz en el chapitel -->
			<line x1="79.5" y1="0" x2="79.5" y2="5" stroke="#94a3b8" stroke-width="1.4" stroke-linecap="round"/>
			<line x1="76.5" y1="3" x2="82.5" y2="3" stroke="#94a3b8" stroke-width="1.4" stroke-linecap="round"/>
			<!-- Torre derecha (inacabada — más baja, plana) -->
			<rect x="125" y="27" width="17" height="13" fill="#94a3b8"/>
			<!-- Merlones en la cima (inacabada) -->
			<rect x="125" y="23" width="4" height="5" fill="#94a3b8"/>
			<rect x="131.5" y="23" width="4" height="5" fill="#94a3b8"/>
			<rect x="138" y="23" width="4" height="5" fill="#94a3b8"/>

			<!-- ESPETO DE SARDINAS -->
			<!-- Caña (palo diagonal clavado en la arena) -->
			<line x1="177" y1="55" x2="196" y2="9" stroke="#94a3b8" stroke-width="1.6" stroke-linecap="round"/>
			<!-- Montículo de arena -->
			<path d="M168 52 Q177 48 186 52" stroke="#94a3b8" stroke-width="0.9" stroke-linecap="round"/>
			<!-- Sardina 1 (arriba) — alineada con la caña -->
			<ellipse cx="194.6" cy="14" rx="5.5" ry="1.9" transform="rotate(-68 194.6 14)" fill="#94a3b8"/>
			<!-- Sardina 2 (centro) -->
			<ellipse cx="188.5" cy="28.5" rx="5.5" ry="1.9" transform="rotate(-68 188.5 28.5)" fill="#94a3b8"/>
			<!-- Sardina 3 (abajo) -->
			<ellipse cx="182.4" cy="43" rx="5.5" ry="1.9" transform="rotate(-68 182.4 43)" fill="#94a3b8"/>
		</svg>
		<span class="text-[10px] tracking-[0.3em] text-slate-700 uppercase">Desde Málaga</span>
	</div>
</footer>
