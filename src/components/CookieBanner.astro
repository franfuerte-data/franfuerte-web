---
---

<div
	id="cookie-banner"
	role="dialog"
	aria-label="Aviso de cookies"
	class="fixed bottom-0 left-0 right-0 z-50 border-t border-white/10 bg-[#060816]/95 p-4 shadow-[0_-10px_40px_rgba(2,6,23,0.7)] backdrop-blur-xl sm:bottom-4 sm:left-4 sm:right-auto sm:max-w-md sm:rounded-2xl sm:border sm:border-white/10"
>
	<p class="text-sm font-semibold text-white">Usamos cookies</p>
	<p class="mt-1 text-xs leading-5 text-slate-400">
		Este sitio utiliza cookies técnicas necesarias para su funcionamiento. No usamos cookies de
		seguimiento ni publicidad sin tu consentimiento.
		<a href="/politica-de-cookies" class="text-violet-400 underline underline-offset-2 hover:text-violet-300">
			Política de cookies
		</a>
	</p>
	<div class="mt-3 flex flex-wrap gap-2">
		<button
			id="cookie-accept"
			class="rounded-full bg-gradient-to-r from-violet-600 to-indigo-600 px-4 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:opacity-90"
		>
			Aceptar todo
		</button>
		<button
			id="cookie-reject"
			class="rounded-full border border-white/20 bg-white/5 px-4 py-1.5 text-xs font-semibold text-slate-300 transition hover:bg-white/10"
		>
			Solo necesarias
		</button>
	</div>
</div>

<script>
	const banner = document.getElementById('cookie-banner');
	const acceptBtn = document.getElementById('cookie-accept');
	const rejectBtn = document.getElementById('cookie-reject');

	const STORAGE_KEY = 'cookie_consent';

	function hideBanner() {
		if (banner) banner.style.display = 'none';
	}

	const stored = localStorage.getItem(STORAGE_KEY);
	if (stored) {
		hideBanner();
	}

	acceptBtn?.addEventListener('click', () => {
		localStorage.setItem(STORAGE_KEY, 'all');
		hideBanner();
	});

	rejectBtn?.addEventListener('click', () => {
		localStorage.setItem(STORAGE_KEY, 'necessary');
		hideBanner();
	});
</script>
