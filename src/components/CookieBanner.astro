---
---

<!-- Cookie bar — bottom fixed bar -->
<div
	id="cookie-bar"
	style="display:none"
	class="fixed bottom-0 left-0 right-0 z-50 border-t border-white/10 bg-[#0b1120]/95 px-5 py-4 backdrop-blur-xl sm:bottom-4 sm:left-4 sm:right-4 sm:rounded-2xl sm:border"
>
	<div class="mx-auto flex max-w-5xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
		<p class="text-sm leading-6 text-slate-300">
			Usamos cookies propias para mejorar tu experiencia. Puedes aceptar todas, rechazarlas o configurarlas.
			<a href="/politica-de-cookies/" class="ml-1 text-violet-400 underline underline-offset-2 hover:text-violet-300">Más información</a>
		</p>
		<div class="flex flex-shrink-0 flex-wrap items-center gap-2">
			<button id="cookie-config" class="rounded-full border border-white/20 px-4 py-2 text-xs font-semibold text-slate-300 transition hover:border-violet-400/40 hover:text-white">
				Configurar
			</button>
			<button id="cookie-reject" class="rounded-full border border-white/20 bg-white/5 px-4 py-2 text-xs font-semibold text-slate-300 transition hover:bg-white/10">
				Rechazar
			</button>
			<button id="cookie-accept" class="rounded-full bg-gradient-to-r from-violet-600 to-indigo-600 px-5 py-2 text-xs font-semibold text-white shadow-sm transition hover:opacity-90">
				Aceptar todo
			</button>
		</div>
	</div>
</div>

<!-- Cookie preferences modal — uses inline styles for reliable overlay -->
<div id="cookie-modal" style="display:none; position:fixed; inset:0; z-index:9999; align-items:center; justify-content:center; padding:1rem; background:rgba(0,0,0,0.75); backdrop-filter:blur(6px)">
	<div style="position:relative; width:100%; max-width:32rem; background:#0f1729; border:1px solid rgba(255,255,255,0.1); border-radius:1rem; padding:1.5rem; box-shadow:0 25px 60px rgba(0,0,0,0.6)">
		<h2 class="text-base font-bold text-white">Configurar cookies</h2>
		<p class="mt-2 text-sm leading-6 text-slate-400">
			Selecciona qué tipos de cookies quieres permitir. Las necesarias son obligatorias y no se pueden desactivar.
		</p>

		<div class="mt-5 space-y-3">
			<!-- Necesarias (locked) -->
			<div class="flex items-start justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-3">
				<div>
					<p class="text-sm font-semibold text-white">Necesarias</p>
					<p class="mt-0.5 text-xs text-slate-400">Funcionamiento básico del sitio. Siempre activas.</p>
				</div>
				<span class="ml-4 mt-0.5 flex-shrink-0 rounded-full bg-violet-600/20 px-2.5 py-1 text-[10px] font-semibold text-violet-300">Siempre activas</span>
			</div>

			<!-- Analíticas -->
			<label class="flex cursor-pointer items-start justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-3">
				<div>
					<p class="text-sm font-semibold text-white">Analíticas</p>
					<p class="mt-0.5 text-xs text-slate-400">Nos ayudan a entender cómo se usa el sitio (visitas anónimas).</p>
				</div>
				<div class="relative ml-4 mt-0.5 flex-shrink-0">
					<input id="toggle-analytics" type="checkbox" class="peer sr-only" />
					<div class="h-5 w-9 rounded-full bg-slate-700 transition peer-checked:bg-violet-600"></div>
					<div class="absolute left-0.5 top-0.5 h-4 w-4 rounded-full bg-white shadow transition peer-checked:translate-x-4"></div>
				</div>
			</label>

			<!-- Marketing -->
			<label class="flex cursor-pointer items-start justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-3">
				<div>
					<p class="text-sm font-semibold text-white">Marketing</p>
					<p class="mt-0.5 text-xs text-slate-400">Permiten mostrar contenido relevante y medir campañas.</p>
				</div>
				<div class="relative ml-4 mt-0.5 flex-shrink-0">
					<input id="toggle-marketing" type="checkbox" class="peer sr-only" />
					<div class="h-5 w-9 rounded-full bg-slate-700 transition peer-checked:bg-violet-600"></div>
					<div class="absolute left-0.5 top-0.5 h-4 w-4 rounded-full bg-white shadow transition peer-checked:translate-x-4"></div>
				</div>
			</label>
		</div>

		<div class="mt-5 flex gap-3">
			<button id="cookie-save-prefs" class="flex-1 rounded-full bg-gradient-to-r from-violet-600 to-indigo-600 py-2.5 text-sm font-semibold text-white transition hover:opacity-90">
				Guardar preferencias
			</button>
			<button id="cookie-modal-close" class="rounded-full border border-white/20 px-5 py-2.5 text-sm font-semibold text-slate-300 transition hover:bg-white/5">
				Cancelar
			</button>
		</div>
	</div>
</div>

<script>
	const KEY = 'cookie_consent_v2';
	const bar = document.getElementById('cookie-bar');
	const modal = document.getElementById('cookie-modal');

	function hideBar() { if (bar) bar.style.display = 'none'; }
	function showBar() { if (bar) bar.style.display = 'block'; }
	function showModal() { if (modal) modal.style.display = 'flex'; }
	function hideModal() { if (modal) modal.style.display = 'none'; }

	function saveConsent(value: string) {
		localStorage.setItem(KEY, value);
		hideBar();
		hideModal();
	}

	if (!localStorage.getItem(KEY)) showBar();

	document.getElementById('cookie-accept')?.addEventListener('click', () => saveConsent('all'));
	document.getElementById('cookie-reject')?.addEventListener('click', () => saveConsent('necessary'));
	document.getElementById('cookie-config')?.addEventListener('click', showModal);
	document.getElementById('cookie-modal-close')?.addEventListener('click', hideModal);
	document.getElementById('cookie-modal')?.querySelector('[style]')?.addEventListener?.('click', (e) => {
		if (e.target === modal) hideModal();
	});

	document.getElementById('cookie-save-prefs')?.addEventListener('click', () => {
		const analytics = (document.getElementById('toggle-analytics') as HTMLInputElement)?.checked;
		const marketing = (document.getElementById('toggle-marketing') as HTMLInputElement)?.checked;
		const cats = ['necessary'];
		if (analytics) cats.push('analytics');
		if (marketing) cats.push('marketing');
		saveConsent(cats.join(','));
	});

	// Close modal on backdrop click
	modal?.addEventListener('click', (e) => {
		if (e.target === modal) hideModal();
	});
</script>
