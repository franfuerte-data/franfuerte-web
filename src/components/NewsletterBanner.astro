---
---

<section
	id="newsletter-form"
	class="rounded-[2rem] border border-violet-500/20 bg-gradient-to-br from-violet-950/60 to-indigo-950/60 p-8 shadow-[0_25px_70px_rgba(109,40,217,0.15)] backdrop-blur-xl lg:p-10"
>
	<div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
		<div class="max-w-xl">
			<p class="text-sm font-semibold uppercase tracking-[0.3em] text-violet-300">Newsletter gratuito</p>
			<h2 class="mt-2 text-2xl font-black tracking-tight text-white sm:text-3xl">
				Contenido de calidad, antes que nadie.
			</h2>
			<p class="mt-3 text-base leading-7 text-slate-300">
				Artículos sobre <strong class="text-violet-200">Microsoft Fabric</strong>, Power BI, arquitecturas de datos y
				estrategia analítica. Sin spam, sin ruido.
			</p>
		</div>

		<form
			id="newsletter-form-el"
			class="flex w-full max-w-md flex-col gap-3 sm:flex-row lg:w-auto"
			novalidate
		>
			<label for="newsletter-email" class="sr-only">Tu correo electrónico</label>
			<input
				id="newsletter-email"
				type="email"
				name="email"
				required
				placeholder="tu@correo.com"
				autocomplete="email"
				class="flex-1 rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm text-white placeholder-slate-500 outline-none transition focus:border-violet-400/50 focus:ring-2 focus:ring-violet-500/30"
			/>
			<button
				type="submit"
				id="newsletter-btn"
				class="rounded-full bg-gradient-to-r from-violet-600 to-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-600/25 transition hover:translate-y-[-1px] hover:shadow-violet-600/40 active:translate-y-0 disabled:opacity-60"
			>
				Suscribirme
			</button>
		</form>

		<div
			id="newsletter-success"
			class="hidden w-full max-w-md rounded-2xl border border-emerald-500/30 bg-emerald-500/10 px-6 py-4 text-sm text-emerald-300"
		>
			<p class="font-semibold">¡Listo! Te has suscrito correctamente.</p>
			<p class="mt-1 text-emerald-400/80">Recibirás los próximos artículos antes que nadie.</p>
		</div>

		<div
			id="newsletter-error"
			class="hidden w-full max-w-md rounded-2xl border border-red-500/30 bg-red-500/10 px-6 py-4 text-sm text-red-300"
		>
			<p class="font-semibold">Algo no ha ido bien.</p>
			<p class="mt-1 text-red-400/80">Inténtalo de nuevo o escríbeme a <a href="mailto:fran.fuerte.grund@outlook.es" class="underline">fran.fuerte.grund@outlook.es</a>.</p>
		</div>
	</div>

	<p class="mt-4 text-xs text-slate-500">
		Sin spam. Puedes darte de baja en cualquier momento. Tus datos no se comparten con terceros.
	</p>
</section>

<script>
	const form = document.getElementById('newsletter-form-el') as HTMLFormElement | null;
	const btn = document.getElementById('newsletter-btn') as HTMLButtonElement | null;
	const successMsg = document.getElementById('newsletter-success');
	const errorMsg = document.getElementById('newsletter-error');

	if (form) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();

			const emailInput = form.querySelector<HTMLInputElement>('#newsletter-email');
			if (!emailInput || !emailInput.value || !emailInput.validity.valid) {
				emailInput?.focus();
				return;
			}

			if (btn) {
				btn.disabled = true;
				btn.textContent = 'Enviando…';
			}

			try {
				const res = await fetch('https://formsubmit.co/ajax/fran.fuerte.grund@outlook.es', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
					body: JSON.stringify({
						email: emailInput.value,
						_subject: 'Nueva suscripción al newsletter — franfuerte.dev',
						_cc: 'fran.fuerte.grund@outlook.es',
						_captcha: 'false',
						_template: 'table',
						fecha_suscripcion: new Date().toISOString(),
						origen: 'franfuerte.dev — newsletter',
					}),
				});

				if (res.ok) {
					form.classList.add('hidden');
					successMsg?.classList.remove('hidden');
				} else {
					throw new Error('Response not ok');
				}
			} catch {
				errorMsg?.classList.remove('hidden');
				if (btn) {
					btn.disabled = false;
					btn.textContent = 'Suscribirme';
				}
			}
		});
	}
</script>
