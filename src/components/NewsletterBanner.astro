---
// Para activar el formulario: regístrate en https://formspree.io y reemplaza
// YOUR_FORM_ID con tu ID (ej: https://formspree.io/f/xyzabcde)
---

<section class="rounded-[2rem] border border-violet-500/20 bg-gradient-to-br from-violet-950/60 to-indigo-950/60 p-8 shadow-[0_25px_70px_rgba(109,40,217,0.15)] backdrop-blur-xl lg:p-10">
	<div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
		<div class="max-w-xl">
			<p class="text-sm font-semibold uppercase tracking-[0.3em] text-violet-300">Newsletter gratuito</p>
			<h2 class="mt-2 text-2xl font-black tracking-tight text-white sm:text-3xl">
				Contenido de calidad, antes que nadie.
			</h2>
			<p class="mt-3 text-base leading-7 text-slate-300">
				Artículos sobre <strong class="text-violet-200">Microsoft Fabric</strong>, Power BI, arquitecturas de datos y estrategia analítica. Sin spam, sin ruido.
			</p>
		</div>

		<form
			action="https://formspree.io/f/YOUR_FORM_ID"
			method="POST"
			class="flex w-full max-w-md flex-col gap-3 sm:flex-row lg:w-auto"
		>
			<label for="newsletter-email" class="sr-only">Tu correo electrónico</label>
			<input
				id="newsletter-email"
				type="email"
				name="email"
				required
				placeholder="tu@correo.com"
				class="flex-1 rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm text-white placeholder-slate-500 outline-none transition focus:border-violet-400/50 focus:ring-2 focus:ring-violet-500/30"
			/>
			<button
				type="submit"
				class="rounded-full bg-gradient-to-r from-violet-600 to-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-600/25 transition hover:translate-y-[-1px] hover:shadow-violet-600/40 active:translate-y-0"
			>
				Suscribirme
			</button>
		</form>
	</div>

	<p class="mt-4 text-xs text-slate-500">
		Sin spam. Puedes darte de baja en cualquier momento. Tus datos no se comparten con terceros.
	</p>
</section>
