---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

// Normalize both sides — trim trailing slash unless the path is just "/"
const normalize = (s: string) => {
	if (!s || s === '/') return '/';
	// Ensure leading slash
	const withLead = s.startsWith('/') ? s : '/' + s;
	return withLead === '/' ? '/' : withLead.replace(/\/+$/, '');
};

const currentPath = normalize(Astro.url.pathname);
const linkPath = normalize(String(href));

// Root only matches root; other paths match themselves or their sub-pages
const isActive =
	linkPath === '/'
		? currentPath === '/'
		: currentPath === linkPath || currentPath.startsWith(linkPath + '/');
---

<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}>
	<slot />
	{isActive && <span class="active-dot" aria-hidden="true"></span>}
</a>

<style>
	a {
		position: relative;
		display: inline-block;
		text-decoration: none;
		padding: 0.35rem 0.1rem;
		color: #cbd5e1; /* slate-300 */
		transition: color 0.15s ease;
	}
	a:hover {
		color: #fff;
	}
	a.active {
		color: #fff;
		font-weight: 600;
	}
	a.active::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: -2px;
		height: 2px;
		border-radius: 2px;
		background: linear-gradient(90deg, #a78bfa, #22d3ee);
	}
	.active-dot {
		position: absolute;
		top: 4px;
		right: -8px;
		width: 5px;
		height: 5px;
		border-radius: 9999px;
		background: #22d3ee;
		box-shadow: 0 0 8px rgba(34, 211, 238, 0.7);
	}
</style>
