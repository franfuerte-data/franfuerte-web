---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="border-b border-white/10 bg-[#060816]/80 backdrop-blur-xl sticky top-0 z-50">
	<nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4 sm:px-8">
		<a href="/" class="text-base font-black tracking-[0.2em] text-white uppercase transition hover:text-violet-200">
			Fran Fuerte
		</a>
		<div class="flex items-center gap-6 text-sm font-medium text-slate-300">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">Sobre mí</HeaderLink>
			<a
				href="https://www.linkedin.com/in/franfuertegrund/"
				target="_blank"
				rel="noreferrer"
				aria-label="LinkedIn de Fran Fuerte"
				class="flex h-8 w-8 items-center justify-center rounded-full border border-white/10 bg-white/5 text-slate-300 transition hover:border-violet-400/40 hover:text-violet-200"
			>
				<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
					<path d="M6.94 8.5A1.56 1.56 0 1 0 6.94 5.38a1.56 1.56 0 0 0 0 3.12ZM5.5 9.75h2.88V18H5.5zM10.16 9.75h2.76v1.13h.04c.38-.72 1.31-1.48 2.7-1.48 2.89 0 3.42 1.9 3.42 4.37V18h-2.88v-3.88c0-1.08-.02-2.47-1.51-2.47-1.51 0-1.74 1.18-1.74 2.39V18h-2.87V9.75z" />
				</svg>
			</a>
		</div>
	</nav>
</header>
