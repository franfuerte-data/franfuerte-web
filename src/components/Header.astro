---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';

// Normalize current path for the Contacto button active state
const normalize = (s: string) => (s === '/' ? '/' : s.replace(/\/$/, ''));
const currentPath = normalize(Astro.url.pathname);
const isContactoActive = currentPath === '/contacto';
---

<header class="border-b border-white/10 bg-[#060816]/80 backdrop-blur-xl sticky top-0 z-50">
	<nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4 sm:px-8">
		<a href="/" class="text-base font-black tracking-[0.2em] text-white uppercase transition hover:text-violet-200">
			Fran Fuerte
		</a>
		<div class="flex items-center gap-5 text-sm font-medium text-slate-300">
			<HeaderLink href="/" class="hidden sm:inline">Inicio</HeaderLink>
			<HeaderLink href="/blog/">Blog</HeaderLink>
			<HeaderLink href="/about/">Sobre mí</HeaderLink>
			<a
				href="/contacto/"
				aria-current={isContactoActive ? 'page' : undefined}
				class:list={[
					'relative rounded-full px-3.5 py-1.5 text-xs font-semibold text-white transition hover:translate-y-[-1px]',
					isContactoActive
						? 'bg-gradient-to-r from-violet-500 to-cyan-500 shadow-lg shadow-cyan-500/30 ring-2 ring-cyan-400/40 ring-offset-2 ring-offset-[#060816]'
						: 'bg-gradient-to-r from-violet-600 to-indigo-600 shadow-sm shadow-violet-600/25',
				]}
			>
				Contacto
				{isContactoActive && <span class="ml-1.5 inline-block h-1.5 w-1.5 rounded-full bg-white align-middle shadow-[0_0_6px_rgba(255,255,255,0.9)]"></span>}
			</a>
			<a
				href="https://www.linkedin.com/in/franfuertegrund/"
				target="_blank"
				rel="noreferrer"
				aria-label="LinkedIn de Fran Fuerte"
				class="hidden h-8 w-8 items-center justify-center rounded-full border border-white/10 bg-white/5 text-slate-300 transition hover:border-violet-400/40 hover:text-violet-200 sm:flex"
			>
				<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
					<path d="M6.94 8.5A1.56 1.56 0 1 0 6.94 5.38a1.56 1.56 0 0 0 0 3.12ZM5.5 9.75h2.88V18H5.5zM10.16 9.75h2.76v1.13h.04c.38-.72 1.31-1.48 2.7-1.48 2.89 0 3.42 1.9 3.42 4.37V18h-2.88v-3.88c0-1.08-.02-2.47-1.51-2.47-1.51 0-1.74 1.18-1.74 2.39V18h-2.87V9.75z" />
				</svg>
			</a>
		</div>
	</nav>
</header>
