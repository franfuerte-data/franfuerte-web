---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import NewsletterBanner from '../../components/NewsletterBanner.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const tagMap: Record<string, string> = {
	'powerbi-decisiones':                'Power BI',
	'lakehouse-vs-datawarehouse-fabric': 'Microsoft Fabric',
	'onelake-catalog-governance':        'Governance',
	'arquitectura-medallion-fabric':     'Data Engineering',
	'claude-powerbi-mcp-server':         'IA + Power BI',
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Blog | ${SITE_TITLE}`}
			description="Artículos técnicos sobre Microsoft Fabric, Power BI, arquitecturas de datos y data engineering en español."
		/>
	</head>
	<body class="bg-[#060816] text-slate-300" style="font-family: var(--font-atkinson, Arial, sans-serif)">
		<Header />

		<main class="mx-auto max-w-4xl px-6 py-12 sm:px-8">
			<header class="mb-10">
				<p class="text-sm font-semibold uppercase tracking-[0.3em] text-violet-300">Blog</p>
				<h1 class="mt-2 text-4xl font-black tracking-tight text-white sm:text-5xl">
					Microsoft Fabric, Power BI<br/>y arquitecturas de datos.
				</h1>
				<p class="mt-4 max-w-2xl text-lg leading-7 text-slate-400">
					Artículos técnicos en español con código real, referencias a expertos del sector y criterio de alguien que trabaja con estos sistemas cada día.
				</p>
			</header>

			{posts.length === 0 ? (
				<p class="text-slate-500">No hay artículos publicados todavía.</p>
			) : (
				<div class="flex flex-col gap-6">
					{posts.map((post, i) => {
						const tag = tagMap[post.id] ?? 'Fabric';
						return (
							<article class={`group rounded-2xl border border-white/10 bg-gradient-to-br transition hover:border-violet-500/30 ${i === 0 ? 'from-violet-950/40 to-indigo-950/30' : 'from-white/8 to-white/4'}`}>
								<a href={`/blog/${post.id}/`} class="flex flex-col gap-4 p-6 sm:flex-row sm:gap-6">
									{post.data.heroImage && (
										<div class="flex-none overflow-hidden rounded-xl border border-white/10 sm:w-48 sm:h-28">
											<Image
												width={400}
												height={200}
												src={post.data.heroImage}
												alt={post.data.title}
												class="h-full w-full object-cover transition group-hover:scale-[1.03]"
											/>
										</div>
									)}
									<div class="flex flex-col justify-center gap-2">
										<div class="flex items-center gap-3">
											<span class="rounded-full border border-violet-400/25 bg-violet-500/10 px-2.5 py-0.5 text-xs font-semibold tracking-wider text-violet-200 uppercase">
												{tag}
											</span>
											<span class="text-xs text-slate-500">
												<FormattedDate date={post.data.pubDate} />
											</span>
										</div>
										<h2 class="text-xl font-bold leading-snug text-white transition group-hover:text-violet-200">
											{post.data.title}
										</h2>
										<p class="text-sm leading-6 text-slate-400 line-clamp-2">
											{post.data.description}
										</p>
										<span class="mt-1 text-sm font-semibold text-violet-300 transition group-hover:text-violet-200">
											Leer artículo →
										</span>
									</div>
								</a>
							</article>
						);
					})}
				</div>
			)}

			<div class="mt-14">
				<NewsletterBanner />
			</div>
		</main>

		<Footer />
	</body>
</html>
