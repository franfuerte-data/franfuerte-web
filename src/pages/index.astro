---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import NewsletterBanner from '../components/NewsletterBanner.astro';
import profileImage from '../images/profile.webp';

const allPosts = await getCollection('blog');
const latestPosts = allPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const tagMap: Record<string, string> = {
	'powerbi-decisiones':              'Power BI',
	'lakehouse-vs-datawarehouse-fabric': 'Microsoft Fabric',
	'onelake-catalog-governance':      'Governance',
	'arquitectura-medallion-fabric':   'Data Engineering',
};

const socialLinks = [
	{ name: 'LinkedIn', href: 'https://www.linkedin.com/in/franfuertegrund/', label: 'LinkedIn de Fran Fuerte' },
	{ name: 'YouTube',  href: 'https://www.youtube.com/',  label: 'Canal de YouTube' },
];

const highlights = [
	'Microsoft Fabric, Power BI y SQL con foco en decisiones reales',
	'Arquitecturas de datos modernas: Lakehouse, Medallion, Governance',
	'Data Analytics Manager en Avanade — del operativo a la estrategia',
];
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="min-h-screen bg-[radial-gradient(circle_at_top_left,_rgba(124,58,237,0.24),_transparent_30%),radial-gradient(circle_at_top_right,_rgba(79,70,229,0.22),_transparent_35%)]">

		<header class="mx-auto flex max-w-7xl items-center justify-between px-6 py-6 sm:px-8 lg:px-10">
			<a href="#top" class="text-lg font-black tracking-[0.25em] text-white uppercase">
				Fran Fuerte
			</a>
			<nav class="hidden items-center gap-7 text-sm font-medium text-slate-300 md:flex">
				<a href="#about" class="transition hover:text-white">Sobre mí</a>
				<a href="/blog"  class="transition hover:text-white">Blog</a>
				<a href="#newsletter" class="transition hover:text-white">Newsletter</a>
			</nav>
			<a href="mailto:fran.fuerte.grund@outlook.es" class="rounded-full bg-gradient-to-r from-violet-600 to-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-violet-600/20 transition hover:scale-[1.02]">
				Contacto
			</a>
		</header>

		<main class="mx-auto flex max-w-7xl flex-col gap-8 px-6 pb-16 sm:px-8 lg:px-10">

			<!-- HERO -->
			<section id="top" class="min-h-[90vh] rounded-[2.2rem] border border-white/10 bg-black/20 p-8 shadow-[0_0_0_1px_rgba(255,255,255,0.03)_inset,0_35px_90px_rgba(2,6,23,0.55)] backdrop-blur-xl md:p-10 lg:p-14">
				<div class="flex h-full flex-col justify-center">
					<p class="mb-6 inline-flex w-fit rounded-full border border-violet-400/25 bg-violet-500/10 px-3.5 py-1.5 text-sm font-semibold tracking-[0.22em] text-violet-200 uppercase">
						Data Analytics Manager · Avanade
					</p>
					<h1 class="max-w-4xl text-5xl font-black leading-[0.95] tracking-tight text-white md:text-7xl">
						De la gestión a las<br/>decisiones basadas en datos.
					</h1>
					<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 md:text-xl">
						Artículos técnicos sobre <strong class="text-violet-200">Microsoft Fabric</strong>, Power BI, arquitecturas de datos y data engineering. En español, con criterio real.
					</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a href="/blog" class="rounded-full bg-gradient-to-r from-violet-600 to-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-600/25 transition hover:translate-y-[-1px]">
							Leer el blog
						</a>
						<a href="#newsletter" class="rounded-full border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold text-slate-100 transition hover:bg-white/15">
							Suscribirme al newsletter
						</a>
					</div>

					<div class="mt-8 flex flex-wrap gap-3">
						{socialLinks.map((link) => (
							<a
								href={link.href}
								target="_blank"
								rel="noreferrer"
								aria-label={link.label}
								class="flex h-11 items-center gap-2 rounded-full border border-white/10 bg-slate-900/80 px-4 text-sm text-slate-200 transition hover:border-violet-400/40 hover:text-violet-200"
							>
								{link.name === 'LinkedIn' && (
									<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
										<path d="M6.94 8.5A1.56 1.56 0 1 0 6.94 5.38a1.56 1.56 0 0 0 0 3.12ZM5.5 9.75h2.88V18H5.5zM10.16 9.75h2.76v1.13h.04c.38-.72 1.31-1.48 2.7-1.48 2.89 0 3.42 1.9 3.42 4.37V18h-2.88v-3.88c0-1.08-.02-2.47-1.51-2.47-1.51 0-1.74 1.18-1.74 2.39V18h-2.87V9.75z" />
									</svg>
								)}
								{link.name === 'YouTube' && (
									<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
										<path d="M23.5 6.8a3.01 3.01 0 0 0-2.11-2.13C19.56 4 12 4 12 4s-7.56 0-9.39.67A3.01 3.01 0 0 0 .5 6.8 31.2 31.2 0 0 0 0 12a31.2 31.2 0 0 0 .5 5.2 3.01 3.01 0 0 0 2.11 2.13C4.44 20 12 20 12 20s7.56 0 9.39-.67a3.01 3.01 0 0 0 2.11-2.13A31.2 31.2 0 0 0 24 12a31.2 31.2 0 0 0-.5-5.2ZM9.75 15.5V8.5l6.25 3.5-6.25 3.5Z" />
									</svg>
								)}
								<span class="text-xs font-medium">{link.name}</span>
							</a>
						))}
					</div>
				</div>
			</section>

			<!-- ABOUT -->
			<section id="about" class="grid gap-6 rounded-[2rem] border border-white/10 bg-zinc-950/70 p-8 shadow-[0_25px_70px_rgba(2,6,23,0.35)] lg:grid-cols-[0.95fr_1.05fr] lg:p-10">
				<div class="overflow-hidden rounded-[2rem] border border-white/10">
					<img src={profileImage.src} alt="Fran Fuerte — Data Analytics Manager" class="h-auto w-full max-h-[420px] object-cover" loading="lazy" decoding="async" />
				</div>

				<div class="flex flex-col justify-center">
					<p class="text-sm font-semibold uppercase tracking-[0.3em] text-violet-200">Sobre mí</p>
					<h2 class="mt-3 text-3xl font-black tracking-tight text-white sm:text-4xl">
						Creo en el valor de unir datos, criterio y acción.
					</h2>
					<p class="mt-5 text-lg leading-8 text-slate-300">
						Data Analytics Manager en Avanade con experiencia en arquitecturas de datos, Microsoft Fabric y Power BI. Este blog nace de la necesidad de contenido técnico en español de calidad real.
					</p>
					<ul class="mt-6 space-y-3 text-slate-300">
						{highlights.map((item) => (
							<li class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
								<span class="mt-0.5 inline-flex h-5 w-5 flex-none items-center justify-center rounded-full bg-gradient-to-r from-violet-600 to-indigo-600 text-xs font-bold text-white">✓</span>
								<span>{item}</span>
							</li>
						))}
					</ul>
					<a href="/about" class="mt-6 inline-flex w-fit rounded-full border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-semibold text-slate-100 transition hover:bg-white/10">
						Leer mi historia completa
					</a>
				</div>
			</section>

			<!-- BLOG POSTS -->
			<section id="blog" class="rounded-[2rem] border border-white/10 bg-zinc-950/70 p-8 shadow-[0_25px_70px_rgba(2,6,23,0.35)] lg:p-10">
				<div class="flex flex-wrap items-end justify-between gap-3">
					<div>
						<p class="text-sm font-semibold uppercase tracking-[0.3em] text-violet-200">Últimos artículos</p>
						<h2 class="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">Ideas, código y arquitectura para crecer en data.</h2>
					</div>
					<a href="/blog" class="text-sm font-semibold text-slate-300 transition hover:text-white">
						Ver todos →
					</a>
				</div>

				<div class="mt-8 grid gap-5 lg:grid-cols-3">
					{latestPosts.map((post) => {
						const tag = tagMap[post.id] ?? 'Microsoft Fabric';
						return (
							<article class="flex h-full flex-col rounded-[1.5rem] border border-white/10 bg-gradient-to-br from-white/10 to-white/5 p-6">
								<p class="text-xs font-semibold uppercase tracking-[0.3em] text-violet-200">{tag}</p>
								<h3 class="mt-3 text-xl font-semibold leading-snug text-white">{post.data.title}</h3>
								<p class="mt-3 flex-1 text-sm leading-7 text-slate-400">{post.data.description}</p>
								<a href={`/blog/${post.id}/`} class="mt-6 inline-flex w-fit rounded-full border border-white/10 bg-white/10 px-4 py-2 text-sm font-semibold text-slate-100 transition hover:bg-white/15">
									Leer artículo →
								</a>
							</article>
						);
					})}
				</div>
			</section>

			<!-- NEWSLETTER -->
			<section id="newsletter">
				<NewsletterBanner />
			</section>

		</main>

		<footer class="mx-auto flex max-w-7xl flex-col gap-3 border-t border-white/10 px-6 py-6 text-sm text-slate-400 sm:flex-row sm:items-center sm:justify-between sm:px-8 lg:px-10">
			<p>© 2026 Fran Fuerte. Todos los derechos reservados.</p>
			<div class="flex flex-wrap gap-4">
				<a href="#about"  class="transition hover:text-white">Sobre mí</a>
				<a href="/blog"   class="transition hover:text-white">Blog</a>
				<a href="https://www.linkedin.com/in/franfuertegrund/" target="_blank" rel="noreferrer" class="transition hover:text-white">LinkedIn</a>
				<a href="mailto:fran.fuerte.grund@outlook.es" class="transition hover:text-white">Contacto</a>
			</div>
		</footer>
	</div>
</Layout>
