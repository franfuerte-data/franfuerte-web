---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CertificationBadges from '../components/CertificationBadges.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import NewsletterBanner from '../components/NewsletterBanner.astro';
import profileImage from '../images/profile.webp';
import charlaEnfoque from '../images/charla2.jpg';

const allPosts = await getCollection('blog');
const latestPosts = allPosts
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const tagMap: Record<string, string> = {
	'powerbi-decisiones':              'Power BI',
	'lakehouse-vs-datawarehouse-fabric': 'Microsoft Fabric',
	'onelake-catalog-governance':      'Governance',
	'arquitectura-medallion-fabric':   'Data Engineering',
	'claude-powerbi-mcp-server':       'IA + Power BI',
};

const socialLinks = [
	{ name: 'LinkedIn', href: 'https://www.linkedin.com/in/franfuertegrund/', label: 'LinkedIn de Fran Fuerte' },
	{ name: 'YouTube',  href: 'https://www.youtube.com/',  label: 'Canal de YouTube' },
];

const focusAreas = [
	{
		icon: 'M4 6h16M4 12h16M4 18h10',
		title: 'Data Architecture',
		accent: 'violet',
		description: 'Arquitecturas modernas Medallion + OneLake sobre Microsoft Fabric. Del landing zone al modelo dimensional listo para consumo.',
		bullets: ['Lakehouse + Warehouse', 'Delta Lake y OneLake', 'Governance con Purview'],
	},
	{
		icon: 'M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93L4.93 19.07',
		title: 'AI Engineering',
		accent: 'cyan',
		description: 'Integración de LLMs y protocolos MCP en flujos de datos reales. Automatización de tareas repetitivas del modelado y documentación.',
		bullets: ['Claude + Power BI MCP', 'Model Context Protocol', 'Time Intelligence auto'],
	},
	{
		icon: 'M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a3 3 0 015.36-1.87M16 3.13a4 4 0 010 7.75M12 7a4 4 0 100 8 4 4 0 000-8z',
		title: 'Forward Deployed Engineering',
		accent: 'amber',
		description: 'En la trinchera con el cliente. Traducir necesidades de negocio a soluciones técnicas y desplegar en producción sin fricciones.',
		bullets: ['Del pizzero al Data Manager', 'Gestión de equipos técnicos', 'Comunicación business ↔ técnica'],
	},
];
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<Header />
	<div class="min-h-screen bg-[radial-gradient(circle_at_top_left,_rgba(124,58,237,0.24),_transparent_30%),radial-gradient(circle_at_top_right,_rgba(6,182,212,0.18),_transparent_35%)]">

		<main class="mx-auto flex max-w-7xl flex-col gap-8 px-6 pb-16 pt-8 sm:px-8 lg:px-10">

			<!-- HERO -->
			<section id="top" class="min-h-[85vh] rounded-[2.2rem] border border-white/10 bg-black/20 p-8 shadow-[0_0_0_1px_rgba(255,255,255,0.03)_inset,0_35px_90px_rgba(2,6,23,0.55)] backdrop-blur-xl md:p-10 lg:p-14">
				<div class="flex h-full flex-col justify-center">
					<p class="mb-6 inline-flex w-fit items-center gap-2 rounded-full border border-cyan-400/25 bg-cyan-500/10 px-3.5 py-1.5 text-sm font-semibold tracking-[0.22em] text-cyan-200 uppercase">
						<span class="h-2 w-2 rounded-full bg-cyan-400 animate-pulse"></span>
						Data Architecture · AI Engineering
					</p>
					<h1 class="max-w-4xl text-4xl font-black leading-[1.02] tracking-tight text-white md:text-6xl lg:text-7xl">
						Data Architect &amp;<br/>
						<span class="bg-gradient-to-r from-violet-400 via-indigo-300 to-cyan-300 bg-clip-text text-transparent">
							AI Engineer
						</span>
						<br/>en Microsoft Fabric.
					</h1>
					<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300 md:text-xl">
						Soy <strong class="text-white">Fran Fuerte</strong> — Data Analytics Manager en Avanade, <strong class="text-violet-200">Microsoft Fabric Champion 2025</strong> y <strong class="text-violet-200">Power BI Champion 2024</strong>. Diseño arquitecturas de datos modernas e integro <strong class="text-cyan-200">Inteligencia Artificial (LLMs, MCP)</strong> como Forward Deployed Engineer.
					</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a href="/contacto/" class="rounded-full bg-gradient-to-r from-violet-600 to-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-violet-600/25 transition hover:translate-y-[-1px]">
							Reservar asesoría →
						</a>
						<a href="/blog/" class="rounded-full border border-white/20 bg-white/10 px-6 py-3 text-sm font-semibold text-slate-100 transition hover:bg-white/15">
							Leer el blog técnico
						</a>
					</div>

					<div class="mt-8 flex flex-wrap gap-3">
						{socialLinks.map((link) => (
							<a
								href={link.href}
								target="_blank"
								rel="noreferrer"
								aria-label={link.label}
								class="flex h-11 items-center gap-2 rounded-full border border-white/10 bg-slate-900/80 px-4 text-sm text-slate-200 transition hover:border-violet-400/40 hover:text-violet-200"
							>
								{link.name === 'LinkedIn' && (
									<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
										<path d="M6.94 8.5A1.56 1.56 0 1 0 6.94 5.38a1.56 1.56 0 0 0 0 3.12ZM5.5 9.75h2.88V18H5.5zM10.16 9.75h2.76v1.13h.04c.38-.72 1.31-1.48 2.7-1.48 2.89 0 3.42 1.9 3.42 4.37V18h-2.88v-3.88c0-1.08-.02-2.47-1.51-2.47-1.51 0-1.74 1.18-1.74 2.39V18h-2.87V9.75z" />
									</svg>
								)}
								{link.name === 'YouTube' && (
									<svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
										<path d="M23.5 6.8a3.01 3.01 0 0 0-2.11-2.13C19.56 4 12 4 12 4s-7.56 0-9.39.67A3.01 3.01 0 0 0 .5 6.8 31.2 31.2 0 0 0 0 12a31.2 31.2 0 0 0 .5 5.2 3.01 3.01 0 0 0 2.11 2.13C4.44 20 12 20 12 20s7.56 0 9.39-.67a3.01 3.01 0 0 0 2.11-2.13A31.2 31.2 0 0 0 24 12a31.2 31.2 0 0 0-.5-5.2ZM9.75 15.5V8.5l6.25 3.5-6.25 3.5Z" />
									</svg>
								)}
								<span class="text-xs font-medium">{link.name}</span>
							</a>
						))}
					</div>

					<!-- Social proof — Microsoft certifications -->
					<div class="mt-10 border-t border-white/5 pt-8">
						<CertificationBadges variant="inline" />
					</div>
				</div>
			</section>

			<!-- MI ENFOQUE -->
			<section id="enfoque" class="rounded-[2rem] border border-white/10 bg-zinc-950/70 p-8 shadow-[0_25px_70px_rgba(2,6,23,0.35)] lg:p-10">
				<div class="mb-8 grid gap-8 lg:grid-cols-[1fr_1fr] lg:items-center">
					<div class="max-w-xl">
						<p class="text-sm font-semibold uppercase tracking-[0.3em] text-cyan-300">Mi enfoque</p>
						<h2 class="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">
							Del dato al modelo. Del modelo a la decisión.
						</h2>
						<p class="mt-4 text-lg leading-7 text-slate-400">
							Tres capas de trabajo que se apoyan entre sí. No hago "solo Power BI" ni "solo IA": entiendo el pipeline de negocio completo.
						</p>
					</div>
					<div class="relative">
						<div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-br from-violet-600/30 via-transparent to-cyan-500/25 blur-3xl"></div>
						<div class="relative overflow-hidden rounded-2xl border border-white/10 shadow-[0_25px_70px_-15px_rgba(124,58,237,0.45),0_15px_50px_-10px_rgba(6,182,212,0.25)]">
							<Image
								src={charlaEnfoque}
								alt="Fran Fuerte explicando arquitecturas de datos e Inteligencia Artificial en un evento tecnológico"
								widths={[400, 800, 1200]}
								sizes="(max-width: 1024px) 100vw, 50vw"
								class="h-full w-full object-cover"
								loading="lazy"
								decoding="async"
							/>
							<div class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-[#060816]/50 via-transparent to-transparent"></div>
						</div>
					</div>
				</div>

				<div class="grid gap-5 lg:grid-cols-3">
					{focusAreas.map((area) => {
						const colors = {
							violet: { border: 'border-violet-500/20 hover:border-violet-500/40', accent: 'text-violet-300', bg: 'bg-violet-500/10' },
							cyan:   { border: 'border-cyan-500/20 hover:border-cyan-500/40',     accent: 'text-cyan-300',   bg: 'bg-cyan-500/10' },
							amber:  { border: 'border-amber-500/20 hover:border-amber-500/40',   accent: 'text-amber-300',  bg: 'bg-amber-500/10' },
						}[area.accent] ?? { border: 'border-white/10', accent: 'text-white', bg: 'bg-white/10' };
						return (
							<div class={`flex flex-col rounded-2xl border ${colors.border} bg-white/[0.02] p-6 transition`}>
								<div class={`inline-flex h-11 w-11 items-center justify-center rounded-xl ${colors.bg} ${colors.accent}`}>
									<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
										<path d={area.icon} stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</div>
								<h3 class={`mt-5 text-lg font-bold ${colors.accent}`}>{area.title}</h3>
								<p class="mt-2 text-sm leading-6 text-slate-400">{area.description}</p>
								<ul class="mt-4 space-y-1.5 text-xs text-slate-500">
									{area.bullets.map((b) => (
										<li class="flex items-center gap-2">
											<span class={`h-1 w-1 rounded-full ${colors.bg}`}></span>
											{b}
										</li>
									))}
								</ul>
							</div>
						);
					})}
				</div>
			</section>

			<!-- ABOUT -->
			<section id="about" class="grid gap-6 rounded-[2rem] border border-white/10 bg-zinc-950/70 p-8 shadow-[0_25px_70px_rgba(2,6,23,0.35)] lg:grid-cols-[0.95fr_1.05fr] lg:p-10">
				<div class="overflow-hidden rounded-[2rem] border border-white/10">
					<img src={profileImage.src} alt="Fran Fuerte — Data Architect e Ingeniero de IA" class="h-auto w-full max-h-[420px] object-cover" loading="lazy" decoding="async" />
				</div>

				<div class="flex flex-col justify-center">
					<p class="text-sm font-semibold uppercase tracking-[0.3em] text-violet-200">Sobre mí</p>
					<h2 class="mt-3 text-3xl font-black tracking-tight text-white sm:text-4xl">
						De la trinchera operativa a la arquitectura de datos.
					</h2>
					<p class="mt-5 text-lg leading-8 text-slate-300">
						Data Analytics Manager en Avanade. Antes he sido pizzero, socorrista, mozo de almacén, conductor y entrenador de balonmano durante 9 años. Todo eso me dio soft skills que no salen en un curso.
					</p>
					<ul class="mt-6 space-y-3 text-slate-300">
						<li class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
							<span class="mt-0.5 inline-flex h-5 w-5 flex-none items-center justify-center rounded-full bg-gradient-to-r from-violet-600 to-indigo-600 text-xs font-bold text-white">✓</span>
							<span>Microsoft Fabric, Power BI y arquitecturas modernas de datos</span>
						</li>
						<li class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
							<span class="mt-0.5 inline-flex h-5 w-5 flex-none items-center justify-center rounded-full bg-gradient-to-r from-cyan-600 to-teal-600 text-xs font-bold text-white">✓</span>
							<span>Integración de LLMs con MCP para automatizar modelado y documentación</span>
						</li>
						<li class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/5 px-4 py-3">
							<span class="mt-0.5 inline-flex h-5 w-5 flex-none items-center justify-center rounded-full bg-gradient-to-r from-amber-600 to-orange-600 text-xs font-bold text-white">✓</span>
							<span>Del operativo a la estrategia: entiendo el negocio antes que el dato</span>
						</li>
					</ul>
					<a href="/about/" class="mt-6 inline-flex w-fit rounded-full border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-semibold text-slate-100 transition hover:bg-white/10">
						Leer mi historia completa →
					</a>
				</div>
			</section>

			<!-- BLOG POSTS -->
			<section id="blog" class="rounded-[2rem] border border-white/10 bg-zinc-950/70 p-8 shadow-[0_25px_70px_rgba(2,6,23,0.35)] lg:p-10">
				<div class="flex flex-wrap items-end justify-between gap-3">
					<div>
						<p class="text-sm font-semibold uppercase tracking-[0.3em] text-violet-200">Últimos artículos</p>
						<h2 class="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">Ideas, código y arquitectura para crecer en data & IA.</h2>
					</div>
					<a href="/blog/" class="text-sm font-semibold text-slate-300 transition hover:text-white">
						Ver todos →
					</a>
				</div>

				<div class="mt-8 grid gap-5 lg:grid-cols-3">
					{latestPosts.map((post) => {
						const tag = tagMap[post.id] ?? 'Microsoft Fabric';
						const isAI = tag.includes('IA');
						return (
							<article class={`flex h-full flex-col rounded-[1.5rem] border ${isAI ? 'border-cyan-500/25' : 'border-white/10'} bg-gradient-to-br ${isAI ? 'from-cyan-950/40 to-teal-950/20' : 'from-white/10 to-white/5'} p-6`}>
								<p class={`text-xs font-semibold uppercase tracking-[0.3em] ${isAI ? 'text-cyan-300' : 'text-violet-200'}`}>{tag}</p>
								<h3 class="mt-3 text-xl font-semibold leading-snug text-white">{post.data.title}</h3>
								<p class="mt-3 flex-1 text-sm leading-7 text-slate-400">{post.data.description}</p>
								<a href={`/blog/${post.id}/`} class="mt-6 inline-flex w-fit rounded-full border border-white/10 bg-white/10 px-4 py-2 text-sm font-semibold text-slate-100 transition hover:bg-white/15">
									Leer artículo →
								</a>
							</article>
						);
					})}
				</div>
			</section>

			<!-- NEWSLETTER -->
			<section id="newsletter">
				<NewsletterBanner />
			</section>

		</main>

		<Footer />
	</div>
</Layout>
